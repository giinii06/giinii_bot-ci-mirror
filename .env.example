DISCORD_TOKEN=your_bot_token_here
# Optional alias used by brand_new_giinii_bot; when set, it takes precedence.
# DISCORD_BOT_TOKEN=your_bot_token_here
# Optional server scope for slash commands and initial backfill.
# DISCORD_GUILD_ID=
# Optional: defaults to ./data/bot.sqlite
# DATABASE_PATH=./data/bot.sqlite
# 미디어 바이트 저장 위치 (기본값: DATABASE_PATH 옆 media 디렉터리)
# MEDIA_PATH=./data/media
# 이 크기를 넘는 파일은 too_large로 건너뜁니다 (기본 50MB)
# MEDIA_MAX_BYTES=52428800
# 동시에 내려받는 미디어 개수 (기본 4)
# MEDIA_CONCURRENCY=4
# 메시지 백필만 건너뛰고 enrich(상세·미디어)는 그대로 돌립니다. 임시 우회용입니다.
# SKIP_BACKFILL=false
# 다른 음성을 쓰려는 경우에만 지정 (기본값: ./audio/roulette.ogg)
# VOICE_AUDIO_PATH=./audio/roulette.ogg

# AI analysis
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BYNARA_API_KEY=
BYNARA_BASE_URL=https://router.bynara.id/v1
HISTORY_MESSAGE_LIMIT=10000
MAX_CONTEXT_CHARS=160000
INCLUDE_BOT_MESSAGES=false
QUESTION_COOLDOWN_SECONDS=20
WEB_HOST=0.0.0.0
WEB_PORT=3003

# 기니봇아 대화 (giinii_chat 통합). 봇 토큰은 위 DISCORD_TOKEN을 그대로 씁니다.
# 대화는 전용 서버 1489819911277641952 에서만 동작합니다.
# giinii_chat의 OpenRouter 키를 아래에 넣습니다. 비어 있으면 위 OPENROUTER_API_KEY를 씁니다.
# CHAT_OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# REASONING_EFFORT=high
# EXA_API_KEY=
# AGENTS_PATH=SOUL.md
# MEMORY_PATH=./data/memory.md
