DISCORD_TOKEN=your_bot_token_here
# Optional alias. When set it takes precedence over DISCORD_TOKEN.
# DISCORD_BOT_TOKEN=your_bot_token_here
# Optional: defaults to ./data/bot.sqlite
# DATABASE_PATH=./data/bot.sqlite
# 미디어 바이트 저장 위치 (기본값: DATABASE_PATH 옆 media 디렉터리)
# MEDIA_PATH=./data/media
# 이 크기를 넘는 파일은 too_large로 건너뜁니다 (기본 512MB)
# MEDIA_MAX_BYTES=536870912
# 동시에 내려받는 미디어 개수 (기본 4)
# MEDIA_CONCURRENCY=4
# 메시지 백필만 건너뛰고 enrich(상세·미디어)는 그대로 돌립니다. 임시 우회용입니다.
# SKIP_BACKFILL=false
# 커밋 가능한 DB 시드 청크 크기 (기본 30MB)
# SEED_CHUNK_BYTES=31457280
# 시드가 오래됐다고 볼 성장 임계값 (기본 30MB)
# SEED_GROWTH_BYTES=31457280
# 다른 음성을 쓰려는 경우에만 지정 (기본값: ./audio/roulette.ogg)
# VOICE_AUDIO_PATH=./audio/roulette.ogg

# 기니봇아 대화. 봇 토큰은 위 DISCORD_TOKEN을 그대로 씁니다.
# 대화는 전용 서버 1489819911277641952 에서만 동작합니다.
CHAT_OPENROUTER_API_KEY=
# 선택: CHAT_OPENROUTER_API_KEY가 비었을 때 쓰는 대체 키
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# REASONING_EFFORT=low
# EXA_API_KEY=
# AGENTS_PATH=SOUL.md

# Giinii Mind. 판단은 Decision API, 대사는 위 대화 모델이 맡습니다.
# MIND_ENABLED=true
# MIND_DECISION_MODEL=perplexity/pplx-decider-v1.3:free
# MIND_DECISION_FLASH_MODEL=perplexity/pplx-decider-flash-v1.3:free
# MIND_DECISION_API_URL=https://openrouter.ai/api/alpha/decisions
# 기본 1회, 조건부 정밀 판단까지 2회
# MIND_MAX_DECISIONS_PER_TRIGGER=2
# MIND_ADAPTIVE_REFINEMENT=true
# 계정 무료 한도(1000/일, 20/분)보다 낮게 잡은 자체 상한
# MIND_DAILY_BUDGET=900
# MIND_MINUTE_BUDGET=18
# MIND_DECISION_TIMEOUT_MS=3000
# MIND_MEMORY_ENABLED=true
# MIND_MEMORY_CANDIDATES=12
# MIND_MEMORY_SELECTED=5
# MIND_MEMORY_TOKEN_BUDGET=400
# MIND_AUTO_MEMORY=true
# 다른 사용자가 공유를 허용한 개인 기억 검색
# MIND_OTHER_USER_MEMORY_ENABLED=true
# 서버 공용 기억 검색과 적용
# MIND_GUILD_MEMORY_ENABLED=true
# 다른 사용자가 관련된 기억은 설정 없이 항상 공용으로 저장된다
# MIND_RELATIONSHIP_ENABLED=true
# MIND_RELATIONSHIP_UPDATE_LIMIT=0.03
# MIND_FEEDBACK_ENABLED=true
# MIND_SEARCH_TIMEOUT_MS=3000
# MIND_DEBUG=false
