{
  "name": "discord-xp-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "check": "tsc --noEmit && tsc -p activity/tsconfig.json",
    "test": "bun test",
    "build:activity": "vite build --config activity/vite.config.ts",
    "dev:activity": "vite --config activity/vite.config.ts",
    "cleanup:slash": "bun run scripts/cleanup-slash.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.2",
    "discord.js": "^14.25.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "3d-force-graph": "^1.80.2",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@types/bun": "latest",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
